# Get this from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AAYourBotTokenHere

# Optional, defaults to 3000
PORT=3000

# Optional. Root URL of the Telegram Bot API. Defaults to the official server.
# Hosts that block api.telegram.org (Hugging Face Spaces does) must point this
# at a relay, e.g. an existing Cloudflare Pages bridge:
# TELEGRAM_API_ROOT=https://n8n-bridge-2gt.pages.dev

# Optional, comma-separated frontend origins. Defaults to local Vite dev server.
# Example: CORS_ORIGINS=https://your-app.pages.dev
CORS_ORIGINS=http://localhost:5173
